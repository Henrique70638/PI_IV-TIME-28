rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.perfil;
    }

    function usuarioValido(d) {
      return d.keys().hasOnly(['nome', 'perfil', 'bairro', 'cidade', 'avatar', 'criadoEm'])
        && d.keys().hasAll(['nome', 'perfil', 'bairro', 'cidade', 'criadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 60
        && d.perfil in ['ofertante', 'interessado', 'ambos']
        && d.bairro is string && d.bairro.size() > 0
        && d.cidade is string && d.cidade.size() > 0
        && (!('avatar' in d) || d.avatar is string);
    }

    function excedenteValido(d) {
      return d.keys().hasOnly(['ofertanteId', 'ofertanteNome', 'produto', 'descricao', 'categoria', 'quantidade', 'unidade', 'urgencia', 'modalidade', 'localizacao', 'fotos', 'status', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['ofertanteId', 'ofertanteNome', 'produto', 'categoria', 'quantidade', 'unidade', 'urgencia', 'modalidade', 'localizacao', 'status', 'criadoEm', 'atualizadoEm'])
        && d.produto is string && d.produto.size() > 0 && d.produto.size() <= 80
        && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 500))
        && d.categoria in ['frutas', 'verduras', 'legumes', 'mudas']
        && d.quantidade is number && d.quantidade > 0
        && d.unidade in ['kg', 'un', 'maco', 'cacho', 'muda']
        && d.urgencia in ['hoje', 'alguns_dias', 'sem_pressa']
        && d.modalidade in ['doacao', 'venda']
        && d.localizacao is map
        && d.localizacao.keys().hasOnly(['bairro', 'cidade', 'geoAproximada', 'geohash'])
        && d.localizacao.keys().hasAll(['bairro', 'cidade', 'geoAproximada', 'geohash'])
        && d.localizacao.geoAproximada is latlng
        && d.localizacao.geohash is string && d.localizacao.geohash.size() == 10
        && (!('fotos' in d) || (d.fotos is list && d.fotos.size() <= 3))
        && d.status in ['disponivel', 'concluido', 'removido'];
    }

    function matchValido(d, matchId) {
      let ex = get(/databases/$(database)/documents/excedentes/$(d.excedenteId)).data;
      return d.keys().hasOnly(['excedenteId', 'ofertanteId', 'interessadoId', 'ofertanteNome', 'interessadoNome', 'participantes', 'status', 'criterios', 'excedenteResumo', 'ultimaMensagem', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['excedenteId', 'ofertanteId', 'interessadoId', 'ofertanteNome', 'interessadoNome', 'participantes', 'status', 'criterios', 'excedenteResumo', 'criadoEm', 'atualizadoEm'])
        && matchId == d.excedenteId + '_' + d.interessadoId
        && d.interessadoId == request.auth.uid
        && d.ofertanteId == ex.ofertanteId
        && d.ofertanteId != d.interessadoId
        && ex.status == 'disponivel'
        && perfilDe(request.auth.uid) in ['interessado', 'ambos']
        && d.participantes == [d.ofertanteId, d.interessadoId]
        && d.status == 'conectado'
        && d.criterios.keys().hasOnly(['localizacao', 'categoria', 'distanciaKm'])
        && d.criterios.localizacao == true
        && d.criterios.categoria == true
        && d.criterios.distanciaKm is number
        && d.criadoEm == request.time
        && d.atualizadoEm == request.time;
    }

    function mensagemValida(d) {
      return d.keys().hasOnly(['autorId', 'texto', 'criadoEm'])
        && d.autorId == request.auth.uid
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000
        && d.criadoEm == request.time;
    }

    match /usuarios/{uid} {
      allow read: if logado();
      allow create: if dono(uid) && usuarioValido(request.resource.data) && request.resource.data.criadoEm == request.time;
      allow update: if dono(uid) && usuarioValido(request.resource.data) && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;

      match /privado/{doc} {
        allow read, write: if dono(uid);
      }
    }

    match /excedentes/{excedenteId} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.ofertanteId == request.auth.uid
        && perfilDe(request.auth.uid) in ['ofertante', 'ambos']
        && excedenteValido(request.resource.data)
        && request.resource.data.status == 'disponivel'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if logado()
        && resource.data.ofertanteId == request.auth.uid
        && request.resource.data.ofertanteId == resource.data.ofertanteId
        && request.resource.data.criadoEm == resource.data.criadoEm
        && excedenteValido(request.resource.data);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if logado() && request.auth.uid in resource.data.participantes;
      allow create: if logado() && matchValido(request.resource.data, matchId);
      allow update: if logado()
        && request.auth.uid in resource.data.participantes
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ultimaMensagem', 'atualizadoEm', 'concluidoEm'])
        && (request.resource.data.status == resource.data.status
          || request.resource.data.status == 'cancelado'
          || (request.resource.data.status == 'concluido' && request.auth.uid == resource.data.ofertanteId));
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if logado() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantes;
        allow create: if logado()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantes
          && mensagemValida(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
